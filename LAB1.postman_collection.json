    },
    {
      "name": "Exercices",
      "item": [
        {
          "name": "Produits de la catégorie smartphones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/category/smartphones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "category",
                "smartphones"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut HTTP attendu\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test(\"Catégorie smartphones\", () => { const products = pm.response.json().products; pm.expect(products).to.be.an(\"array\").and.not.be.empty; products.forEach(product => pm.expect(product.category).to.equal(\"smartphones\")); });",
                  "pm.test(\"Temps de réponse inférieur à 500 ms\", () => { pm.expect(pm.response.responseTime).to.be.below(500); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ajouter un utilisateur fictif",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "add"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Amine\",\n  \"lastName\": \"Demo\",\n  \"age\": 28\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut HTTP attendu\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test(\"Champs renvoyés\", () => { pm.expect(pm.response.json()).to.include({\"firstName\": \"Amine\", \"lastName\": \"Demo\", \"age\": 28}); });",
                  "pm.test(\"ID utilisateur généré\", () => { pm.expect(pm.response.json().id).to.be.a(\"number\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
